# ローカル開発用の設定例。コピーして `.env.local` を作成する（`*.local` は gitignore 済みでコミットされない）。
#   cp .env.example .env.local
# 変更の反映には、開発サーバーの再起動が必要。

# 開発用の Box アクセストークン（開発サーバー起動時のみ有効。本番ビルドでは使われない）。
# Box Developer Console のアプリの設定から発行する。有効期間は 60 分。
# 期限が切れたら、ブラウザの localStorage の `box_dev_token` に新しいトークンを入れると、再読み込みだけで差し替えられる
# （localStorage の方が、この環境変数より優先される）。
# VITE_BOX_DEV_TOKEN=

# Box API の呼び出し回数を減らすためのキャッシュ（SS 画面）。どちらも既定は無効。true で有効にする。
# Box Content Explorer のフォルダ取得キャッシュ（5 分）。試作（src/prototypes/box-cache-refresh/）で、現在は組み込まれていない。
# 使うときは、src/prototypes/box-cache-refresh/README.md の手順で組み込んでから、true にする。
# VITE_BOX_FOLDER_CACHE=true
# コラボレーター一覧のキャッシュ（5 分）
# VITE_BOX_COLLABORATIONS_CACHE=true

# 無駄な再レンダリングの調査用ログ（開発サーバーのみ）。true で、useRenderLog を呼んでいるコンポーネントの再描画をコンソールに出す。
# VITE_RENDER_LOG=true
