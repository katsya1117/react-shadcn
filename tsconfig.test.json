{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Node",
    "erasableSyntaxOnly": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@test-utils": ["./test/test-utils/index.ts"]
    },
    "types": ["jest", "node", "@testing-library/jest-dom"],
    "noEmit": true
  },
  "include": ["src/**/*", "test/**/*"]
}